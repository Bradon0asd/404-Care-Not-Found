DB_SERVER=127.0.0.1
DB_USER=root
DB_NAME=hackathon
DB_PASSWORD=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Required in production: a stable random key, otherwise every restart invalidates sessions.
SECRET_KEY=
SESSION_FILE_DIR=
SESSION_LIFETIME_DAYS=7
# Set to None + true when the frontend runs on a different origin over HTTPS.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

UPLOAD_FOLDER=
MAX_UPLOAD_BYTES=5242880
PUBLIC_BASE_URL=

# Google AI (Gemini) API
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
# Tiered inference. Leave blank to use GEMINI_MODEL for both passes.
GEMINI_MODEL_FAST=
GEMINI_MODEL_DEEP=

# Comma-separated frontend origins allowed to call the API with the session cookie.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

WEB_APP_BASE_URL=

# LINE Login (SSO) channel - separate from the Messaging API channel above.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:5000/api/auth/line/callback
LINE_LOGIN_SCOPE=openid profile
LINE_LOGIN_BOT_PROMPT=
LINE_LOGIN_STATE_TTL=600
FRONTEND_URL=http://localhost:5173
LINE_LOGIN_SUCCESS_PATH=/auth/callback
LINE_LOGIN_FAILURE_PATH=/auth/role
