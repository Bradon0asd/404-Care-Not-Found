DB_SERVER=127.0.0.1
DB_USER=root
DB_NAME=hackathon
DB_PASSWORD=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Required in production: a stable random key, otherwise every restart invalidates sessions.
SECRET_KEY=
SESSION_FILE_DIR=
SESSION_LIFETIME_DAYS=7
# Set to None + true when the frontend runs on a different origin over HTTPS.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

UPLOAD_FOLDER=
MAX_UPLOAD_BYTES=5242880
PUBLIC_BASE_URL=

# Google AI (Gemini) API
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated frontend origins allowed to call the API with the session cookie.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

WEB_APP_BASE_URL=
